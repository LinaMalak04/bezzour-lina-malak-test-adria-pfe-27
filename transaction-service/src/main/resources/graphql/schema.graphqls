enum TransactionType { DEBIT CREDIT }
enum TransactionStatus { PENDING COMPLETED REJECTED }

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String!
    type: TransactionType!
    status: TransactionStatus!
    transferId: ID
    failureReason: String
}

input CreateTransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

input TransferInput {
    sourceAccountId: ID!
    targetAccountId: ID!
    amount: Float!
    currency: String!
}

type Query {
    transaction(id: ID!): Transaction
    transactionsByAccount(accountId: ID!): [Transaction!]!
}

type Mutation {
    createTransaction(input: CreateTransactionInput!): Transaction!
    transfer(input: TransferInput!): [Transaction!]!
}
